    <section>
      <h2>Arduino Code</h2>
      <p>
        The sketch combines 30 sensing cycles into each reading and waits
        50 ms between readings to keep the serial output readable while
        still responding quickly to touch. I chose 0° and 90° because a
        quarter turn is easy to see in the demo. The threshold of 100 is
        a starting value that should fall between the untouched and
        touched readings in the Serial Monitor.
      </p>

      <pre><code>// Load the library for capacitive touch sensing.
#include &lt;CapacitiveSensor.h&gt;

// Load the library for controlling the servo.
#include &lt;Servo.h&gt;

// Use Pin 2 to send and Pin 4 to receive the sensing signal.
CapacitiveSensor touchSensor(2, 4);

// Create an object to control the servo.
Servo myServo;

// Set a starting threshold for detecting touch.
const long touchThreshold = 100;

// Set up the serial connection and servo when the Arduino starts.
void setup() {
  // Match the Serial Monitor's baud rate.
  Serial.begin(9600);

  // Send the servo control signal through Pin 9.
  myServo.attach(9);

  // Set the servo's starting position to 0 degrees.
  myServo.write(0);
}

// Read the sensor and update the servo repeatedly.
void loop() {
  // Combine 30 sensing cycles into one touch reading.
  long touchValue = touchSensor.capacitiveSensor(30);

  // Label the reading in the Serial Monitor.
  Serial.print("Touch: ");

  // Print the reading so I can check the threshold.
  Serial.println(touchValue);

  // Treat readings above the threshold as a touch.
  if (touchValue &gt; touchThreshold) {
    // Turn the servo a quarter turn when the coin is touched.
    myServo.write(90);
  }
  // Handle readings at or below the threshold.
  else {
    // Return the servo to its starting position.
    myServo.write(0);
  }

  // Wait 50 milliseconds before taking another reading.
  delay(50);
}</code></pre>
